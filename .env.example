# Aviation Clarity — environment contract
#
# This file documents variable NAMES only. Never put a real value in it, and
# never commit a populated .env. Values come from Infisical locally and from
# Vercel project environment variables in preview/production.
#
#   infisical run --env=dev --path=/aviation-clarity -- npm run dev

# --- Supabase (self-hosted) ------------------------------------------------
# The public API gateway URL, not the Studio/admin URL.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.insightprofit.live
SUPABASE_URL=https://supabase.insightprofit.live

# Publishable key. Safe in the browser; Row Level Security applies.
# Set whichever pair your Supabase version issues — the app accepts either,
# preferring the current naming.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Legacy naming, for older self-hosted releases:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key. Server-only — bypasses Row Level Security. Never expose it, and
# never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Legacy naming:
# SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only to apply migrations. Not read by the app.
POSTGRES_URL=

# --- Application -----------------------------------------------------------
# Bearer token required by mutating API routes. Writes fail closed when unset.
AVIATION_CLARITY_API_TOKEN=

# --- Generation ------------------------------------------------------------
# Without these the Explanation Engine still answers, in `scaffold` mode: it
# returns the deterministic outline instead of generated content.
OPENAI_API_KEY=
# Optional. Defaults shown.
# AI_PROVIDER=openai
# OPENAI_MODEL=gpt-4o-2024-08-06
# Point at a compatible gateway or proxy. Leave unset for the public API.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Per-million-token prices. Cost is recorded against each run only when both
# are set, so the figure in the audit trail is either accurate or absent.
# OPENAI_INPUT_COST_PER_MTOK=
# OPENAI_OUTPUT_COST_PER_MTOK=

# --- Payments --------------------------------------------------------------
# Without these, /api/checkout returns 503 and the webhook endpoint refuses
# every request. Use test-mode keys until a real purchase has been verified.
STRIPE_SECRET_KEY=
# From the Stripe dashboard, per webhook endpoint. Required: an unverified
# webhook is an unauthenticated request that can grant entitlements.
STRIPE_WEBHOOK_SECRET=
# Point at a gateway or proxy. Leave unset for Stripe itself.
# STRIPE_API_BASE=https://api.stripe.com/v1
